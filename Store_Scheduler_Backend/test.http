### Store Scheduler API 전체 흐름 예제 (IntelliJ HTTP Client)
# 위에서부터 순서대로 실행하면 토큰·ID가 자동으로 다음 요청에 채워진다.
# 회원가입은 처음 한 번만 성공한다. 다시 처음부터 하려면: docker compose down -v && docker compose up -d
# weekStart는 앞으로 올 월요일, wednesday는 그 주 수요일로 바꿔서 사용한다.

@host = http://localhost:8080
@weekStart = 2026-11-02
@wednesday = 2026-11-04


### ─────────────── 1. 회원가입 · 로그인 ───────────────

### 관리자 회원가입
POST {{host}}/api/auth/signup
Content-Type: application/json

{ "username": "owner01", "password": "password123", "role": "MANAGER" }

### 직원 회원가입 (3명)
POST {{host}}/api/auth/signup
Content-Type: application/json

{ "username": "staff01", "password": "password123", "role": "EMPLOYEE" }

###
POST {{host}}/api/auth/signup
Content-Type: application/json

{ "username": "staff02", "password": "password123", "role": "EMPLOYEE" }

###
POST {{host}}/api/auth/signup
Content-Type: application/json

{ "username": "staff03", "password": "password123", "role": "EMPLOYEE" }

### 관리자 로그인
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "owner01", "password": "password123" }

> {% client.global.set("managerToken", response.body.token); %}

### 직원 로그인
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "staff01", "password": "password123" }

> {% client.global.set("staff1Token", response.body.token); %}

###
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "staff02", "password": "password123" }

> {% client.global.set("staff2Token", response.body.token); %}

###
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "staff03", "password": "password123" }

> {% client.global.set("staff3Token", response.body.token); %}


### ─────────────── 2. 매장 등록 · 직원 합류 ───────────────

### 매장 등록 (관리자) → 매장 코드 발급
POST {{host}}/api/stores
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "name": "광운대점", "address": "서울 노원구 광운로 20" }

> {%
    client.global.set("storeId", response.body.id);
    client.global.set("storeCode", response.body.storeCode);
%}

### 내 매장 목록 (관리자)
GET {{host}}/api/stores
Authorization: Bearer {{managerToken}}

### 매장 설정 (관리자). guaranteeMustDayOff: 대신할 사람이 없어도 필수 휴무일에는 배정하지 않음
PATCH {{host}}/api/stores/{{storeId}}/settings
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "guaranteeMustDayOff": false }

### 매장 코드로 합류 신청 (직원) → 승인 대기
POST {{host}}/api/stores/join/{{storeCode}}
Authorization: Bearer {{staff1Token}}
Content-Type: application/json

{ "name": "김하나", "phoneNumber": "010-1111-1111" }

> {% client.global.set("emp1Id", response.body.employeeId); %}

###
POST {{host}}/api/stores/join/{{storeCode}}
Authorization: Bearer {{staff2Token}}
Content-Type: application/json

{ "name": "이두리", "phoneNumber": "010-2222-2222" }

> {% client.global.set("emp2Id", response.body.employeeId); %}

###
POST {{host}}/api/stores/join/{{storeCode}}
Authorization: Bearer {{staff3Token}}
Content-Type: application/json

{ "name": "박세라", "phoneNumber": "010-3333-3333" }

> {% client.global.set("emp3Id", response.body.employeeId); %}

### 승인 대기 직원 목록 (관리자)
GET {{host}}/api/stores/{{storeId}}/employees/pending
Authorization: Bearer {{managerToken}}

### 합류 승인 + 시급·고용 형태 설정 (관리자). employmentType: PART_TIME(기본) / FULL_TIME
POST {{host}}/api/stores/{{storeId}}/employees/{{emp1Id}}/approve
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "hourlyWage": 10030, "employmentType": "FULL_TIME" }

###
POST {{host}}/api/stores/{{storeId}}/employees/{{emp2Id}}/approve
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "hourlyWage": 10030 }

###
POST {{host}}/api/stores/{{storeId}}/employees/{{emp3Id}}/approve
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "hourlyWage": 10500 }

### 직원 정보 수정 (관리자, 바꿀 항목만)
PATCH {{host}}/api/stores/{{storeId}}/employees/{{emp3Id}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "hourlyWage": 11000 }

### 매장 직원 목록 (관리자)
GET {{host}}/api/stores/{{storeId}}/employees
Authorization: Bearer {{managerToken}}


### ─────────────── 3. 스킬 · 근무 시간대 ───────────────

### 스킬 등록 (관리자)
POST {{host}}/api/stores/{{storeId}}/skills
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "name": "일본어" }

> {% client.global.set("skillId", response.body.id); %}

### 스킬 목록
GET {{host}}/api/stores/{{storeId}}/skills
Authorization: Bearer {{managerToken}}

### 직원에게 스킬 부여 (관리자) — 김하나, 박세라
POST {{host}}/api/stores/{{storeId}}/employees/{{emp1Id}}/skills/{{skillId}}
Authorization: Bearer {{managerToken}}

###
POST {{host}}/api/stores/{{storeId}}/employees/{{emp3Id}}/skills/{{skillId}}
Authorization: Bearer {{managerToken}}

### 근무 시간대 등록 (관리자). dayOfWeek를 비우면 매일, 지정하면 그 요일에만 있는 교대
POST {{host}}/api/stores/{{storeId}}/shifts
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "name": "오픈", "startTime": "09:00", "endTime": "13:00", "requiredStaff": 1, "dayOfWeek": "WEDNESDAY" }

> {% client.global.set("openShiftId", response.body.id); %}

###
POST {{host}}/api/stores/{{storeId}}/shifts
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "name": "마감", "startTime": "17:00", "endTime": "22:00", "requiredStaff": 1, "dayOfWeek": "WEDNESDAY" }

### 근무 시간대 목록
GET {{host}}/api/stores/{{storeId}}/shifts
Authorization: Bearer {{managerToken}}

### 근무 시간대별 필요 스킬 설정 (관리자, 목록 전체 교체) — 오픈에 일본어 가능자 1명
PUT {{host}}/api/stores/{{storeId}}/shifts/{{openShiftId}}/skill-requirements
Authorization: Bearer {{managerToken}}
Content-Type: application/json

[ { "skillId": {{skillId}}, "count": 1 } ]


### ─────────────── 4. 가용 시간 · 휴무 신청 (직원) ───────────────

### 요일별 가용 시간 등록
POST {{host}}/api/availabilities
Authorization: Bearer {{staff1Token}}
Content-Type: application/json

{ "storeId": {{storeId}}, "dayOfWeek": "WEDNESDAY", "startTime": "09:00", "endTime": "22:00" }

###
POST {{host}}/api/availabilities
Authorization: Bearer {{staff2Token}}
Content-Type: application/json

{ "storeId": {{storeId}}, "dayOfWeek": "WEDNESDAY", "startTime": "09:00", "endTime": "22:00" }

###
POST {{host}}/api/availabilities
Authorization: Bearer {{staff3Token}}
Content-Type: application/json

{ "storeId": {{storeId}}, "dayOfWeek": "WEDNESDAY", "startTime": "09:00", "endTime": "22:00" }

### 내 가용 시간 (직원)
GET {{host}}/api/availabilities/my
Authorization: Bearer {{staff1Token}}

### 매장 전체 가용 시간 (관리자)
GET {{host}}/api/stores/{{storeId}}/availabilities
Authorization: Bearer {{managerToken}}

### 날짜별 휴무 신청 (직원). type: MUST(필수) / PREFER(희망)
POST {{host}}/api/stores/{{storeId}}/day-offs
Authorization: Bearer {{staff3Token}}
Content-Type: application/json

{ "date": "{{wednesday}}", "type": "PREFER", "reason": "시험 기간" }

### 내 휴무 신청 (직원)
GET {{host}}/api/stores/{{storeId}}/day-offs/my
Authorization: Bearer {{staff3Token}}

### 매장 휴무 신청 (관리자, 기간 조회)
GET {{host}}/api/stores/{{storeId}}/day-offs?from={{weekStart}}&to={{wednesday}}
Authorization: Bearer {{managerToken}}


### ─────────────── 5. 근무표 자동 생성 · 확정 (관리자) ───────────────

### 주간 근무표 후보안 생성 (weekStart는 월요일). 균형 해 / 최소 비용 해 / 최고 공평 해 3안. 이 단계에서는 근무표가 바뀌지 않는다
POST {{host}}/api/stores/{{storeId}}/schedules/automate?weekStart={{weekStart}}
Authorization: Bearer {{managerToken}}

> {% client.global.set("proposalId", response.body.proposalId); %}

### 후보안 다시 보기
GET {{host}}/api/stores/{{storeId}}/schedules/proposals/{{proposalId}}
Authorization: Bearer {{managerToken}}

### 후보안 확정 → 근무표 교체 + 직원 알림
POST {{host}}/api/stores/{{storeId}}/schedules/proposals/{{proposalId}}/confirm
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "candidateIndex": 0 }

### 매장 근무표 (관리자·직원)
GET {{host}}/api/stores/{{storeId}}/schedules
Authorization: Bearer {{managerToken}}

### 내 근무표 (직원) — 김하나의 첫 근무를 결원 요청 대상으로 사용
GET {{host}}/api/stores/{{storeId}}/schedules/my
Authorization: Bearer {{staff1Token}}

> {% client.global.set("scheduleId", response.body[0].id); %}


### ─────────────── 6. 결원 · 대타 ───────────────

### 결원 요청 (직원 본인 근무)
POST {{host}}/api/stores/{{storeId}}/schedules/{{scheduleId}}/swap-requests
Authorization: Bearer {{staff1Token}}
Content-Type: application/json

{ "reason": "병원 진료" }

> {% client.global.set("swapRequestId", response.body.id); %}

### 결원 요청 목록 (관리자)
GET {{host}}/api/stores/{{storeId}}/swap-requests
Authorization: Bearer {{managerToken}}

### 대타 추천 (관리자) — 가능한 직원 우선, 부족 스킬 보유자 우선, 불가능한 직원은 사유 포함
GET {{host}}/api/stores/{{storeId}}/swap-requests/{{swapRequestId}}/candidates
Authorization: Bearer {{managerToken}}

> {% client.global.set("substituteId", response.body[0].employeeId); %}

### 대타 지정 (관리자) → 대상 직원에게 알림
POST {{host}}/api/stores/{{storeId}}/swap-requests/{{swapRequestId}}/offer
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "employeeId": {{substituteId}} }

### 대타 수락 (지정받은 직원) → 근무 담당자 변경. 거절은 /decline, 요청자 취소는 /cancel
POST {{host}}/api/stores/{{storeId}}/swap-requests/{{swapRequestId}}/accept
Authorization: Bearer {{staff3Token}}


### ─────────────── 7. 급여 · 기타 ───────────────

### 월별 급여 계산 (관리자, 주휴수당 포함)
GET {{host}}/api/stores/{{storeId}}/payroll?yearMonth=2026-11
Authorization: Bearer {{managerToken}}

### 근무 수정 (관리자)
PUT {{host}}/api/stores/{{storeId}}/schedules/{{scheduleId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{ "workDate": "{{wednesday}}", "startTime": "09:00", "endTime": "12:00" }

### 매장 코드 재발급 (관리자)
POST {{host}}/api/stores/{{storeId}}/reissue-code
Authorization: Bearer {{managerToken}}

### 푸시 알림용 기기 토큰 등록 (앱 로그인 후)
PATCH {{host}}/api/users/me/device-token
Authorization: Bearer {{staff1Token}}
Content-Type: application/json

{ "deviceToken": "fcm-device-token-from-app" }
